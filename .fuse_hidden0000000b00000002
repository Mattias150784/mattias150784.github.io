<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Commissions · Mattias15</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
          --bg: #0a0a0b;
          --surface: #111114;
          --surface-2: #161619;
          --border: rgba(255, 255, 255, 0.06);
          --border-strong: rgba(255, 255, 255, 0.1);
          --text: #ededf0;
          --text-muted: #8a8a93;
          --text-subtle: #56565f;
          --green: #4ade80;
          --green-soft: rgba(74, 222, 128, 0.1);
          --orange: #f97316;
          --orange-soft: rgba(249, 115, 22, 0.1);
          --blue: #60a5fa;
          --blue-soft: rgba(96, 165, 250, 0.1);
          --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
        }

        html { scroll-behavior: smooth; }

        body {
          background: var(--bg);
          color: var(--text);
          font-family: 'Inter', system-ui, -apple-system, sans-serif;
          font-size: 15px;
          line-height: 1.6;
          font-feature-settings: 'cv11', 'ss01', 'ss03';
          -webkit-font-smoothing: antialiased;
        }

        ::selection { background: rgba(96, 165, 250, 0.25); color: var(--text); }

        .wrapper {
          max-width: 1080px;
          margin: 0 auto;
          padding: 0 28px;
        }

        /* ── HEADER ────────────────────────── */
        header {
          position: sticky;
          top: 0;
          z-index: 50;
          border-bottom: 1px solid var(--border);
          background: rgba(10, 10, 11, 0.72);
          backdrop-filter: saturate(180%) blur(14px);
          -webkit-backdrop-filter: saturate(180%) blur(14px);
        }

        .topbar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          height: 60px;
        }

        .logo {
          font-family: var(--mono);
          font-size: 14px;
          font-weight: 500;
          color: var(--text);
          text-decoration: none;
        }

        .logo span { color: var(--green); }

        nav {
          display: flex;
          align-items: center;
          gap: 8px;
        }

        nav a {
          font-size: 13.5px;
          font-weight: 500;
          color: var(--text-muted);
          text-decoration: none;
          padding: 7px 14px;
          border-radius: 8px;
          border: 1px solid var(--border);
          background: var(--surface);
          white-space: nowrap;
          transition: color 0.15s, background 0.15s, border-color 0.15s;
        }

        nav a:hover {
          color: var(--text);
          background: var(--surface-2);
          border-color: var(--border-strong);
        }

        nav a.active {
          color: var(--green);
          background: rgba(74, 222, 128, 0.1);
          border-color: rgba(74, 222, 128, 0.3);
        }

        .nav-cta {
          color: #052010 !important;
          background: var(--green);
          border-color: transparent;
          margin-left: 4px;
          font-weight: 600;
        }

        .nav-cta:hover {
          background: #6ee89a;
          border-color: transparent;
        }

        /* ── LAYOUT ────────────────────────── */
        .page-body {
          display: grid;
          grid-template-columns: minmax(0, 1fr) 320px;
          gap: 56px;
          padding: 64px 0 80px;
          align-items: start;
        }

        /* ── FORM HEAD ─────────────────────── */
        .form-eyebrow {
          font-size: 12px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--text-subtle);
          margin-bottom: 22px;
        }

        h1 {
          font-size: clamp(30px, 4.5vw, 44px);
          font-weight: 600;
          line-height: 1.05;
          letter-spacing: -0.03em;
          margin-bottom: 14px;
        }

        h1 em { font-style: normal; color: var(--blue); }

        .form-sub {
          font-size: 15.5px;
          color: var(--text-muted);
          margin-bottom: 28px;
          line-height: 1.65;
          max-width: 500px;
        }

        .avail-pill {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 6px 12px;
          border-radius: 999px;
          background: var(--green-soft);
          color: var(--green);
          font-size: 12.5px;
          font-weight: 500;
          margin-bottom: 36px;
        }

        .avail-dot {
          width: 7px;
          height: 7px;
          border-radius: 50%;
          background: var(--green);
        }

        /* ── FORM ──────────────────────────── */
        .form-group { margin-bottom: 22px; }

        label {
          display: block;
          font-size: 13.5px;
          font-weight: 500;
          color: var(--text);
          margin-bottom: 8px;
        }

        label .req { color: var(--blue); margin-left: 3px; }

        .form-hint {
          font-size: 12.5px;
          color: var(--text-subtle);
          margin-bottom: 10px;
          line-height: 1.5;
        }

        .type-pills {
          display: flex;
          gap: 8px;
          flex-wrap: wrap;
        }

        .type-pill {
          padding: 8px 14px;
          border: 1px solid var(--border);
          background: var(--surface);
          border-radius: 7px;
          font-size: 13.5px;
          font-weight: 500;
          color: var(--text-muted);
          cursor: pointer;
          transition: all 0.15s;
          user-select: none;
        }

        .type-pill:hover {
          border-color: var(--border-strong);
          color: var(--text);
        }

        .type-pill.sel-mc     { background: var(--green-soft);  color: var(--green);  border-color: rgba(74,222,128,0.25); }
        .type-pill.sel-rb     { background: var(--orange-soft); color: var(--orange); border-color: rgba(249,115,22,0.25); }
        .type-pill.sel-custom { background: var(--blue-soft);   color: var(--blue);   border-color: rgba(96,165,250,0.25); }

        input, textarea, select {
          width: 100%;
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 8px;
          padding: 11px 14px;
          font-family: inherit;
          font-size: 14px;
          font-weight: 400;
          color: var(--text);
          transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
          outline: none;
          resize: none;
        }

        input::placeholder, textarea::placeholder { color: var(--text-subtle); }

        input:hover, textarea:hover, select:hover {
          border-color: var(--border-strong);
        }

        input:focus, textarea:focus, select:focus {
          border-color: rgba(96, 165, 250, 0.5);
          background: var(--surface-2);
          box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.08);
        }

        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; }

        .btn-submit {
          width: 100%;
          padding: 12px 20px;
          background: var(--blue);
          color: #fff;
          border: none;
          border-radius: 8px;
          font-family: inherit;
          font-size: 14px;
          font-weight: 500;
          cursor: pointer;
          transition: background 0.15s, transform 0.1s;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          margin-top: 12px;
        }

        .btn-submit:hover { background: #7bb8fc; }
        .btn-submit:active { transform: translateY(1px); }
        .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; }

        .form-message {
          display: none;
          padding: 12px 16px;
          border-radius: 8px;
          font-size: 13px;
          margin-bottom: 22px;
          border: 1px solid;
        }

        .form-message.success {
          background: var(--green-soft);
          color: var(--green);
          border-color: rgba(74,222,128,0.2);
        }

        .form-message.error {
          background: var(--orange-soft);
          color: var(--orange);
          border-color: rgba(249,115,22,0.2);
        }

        /* ── SIDEBAR ───────────────────────── */
        .sidebar {
          position: sticky;
          top: 80px;
          display: flex;
          flex-direction: column;
          gap: 12px;
        }

        .sidebar-card {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 12px;
          padding: 22px;
        }

        .sidebar-card h3 {
          font-size: 11.5px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--text-subtle);
          margin-bottom: 16px;
        }

        .sidebar-row {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 10px 0;
          border-bottom: 1px solid var(--border);
          font-size: 13.5px;
        }

        .sidebar-row:last-child { border-bottom: none; padding-bottom: 0; }
        .sidebar-row:first-of-type { padding-top: 0; }
        .sidebar-row .key { color: var(--text-muted); }
        .sidebar-row .val { color: var(--text); font-weight: 500; }
        .sidebar-row .val.green { color: var(--green); display: inline-flex; align-items: center; gap: 6px; }
        .sidebar-row .val.green::before {
          content: '';
          width: 6px; height: 6px; border-radius: 50%;
          background: var(--green);
        }

        .sidebar-note {
          font-size: 13.5px;
          color: var(--text-muted);
          line-height: 1.6;
          margin-bottom: 14px;
        }

        .discord-link {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          padding: 10px 14px;
          border: 1px solid var(--border-strong);
          border-radius: 8px;
          font-size: 13.5px;
          font-weight: 500;
          color: var(--text);
          text-decoration: none;
          transition: background 0.15s, border-color 0.15s;
        }

        .discord-link:hover {
          background: var(--surface-2);
          border-color: rgba(255, 255, 255, 0.18);
        }

        /* ── STEPS ─────────────────────────── */
        .steps-section {
          border-top: 1px solid var(--border);
          padding: 56px 0 64px;
        }

        .section-label {
          font-size: 11.5px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--text-subtle);
          margin-bottom: 24px;
          display: block;
        }

        .steps-row {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 14px;
        }

        .step {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 12px;
          padding: 24px 22px;
          transition: border-color 0.15s;
        }

        .step:hover { border-color: var(--border-strong); }

        .step-num {
          font-family: var(--mono);
          font-size: 12px;
          font-weight: 500;
          color: var(--blue);
          letter-spacing: 0;
          line-height: 1;
          margin-bottom: 18px;
        }

        .step h4 {
          font-size: 14.5px;
          font-weight: 600;
          margin-bottom: 6px;
          color: var(--text);
          letter-spacing: -0.01em;
        }

        .step p {
          font-size: 13px;
          color: var(--text-muted);
          line-height: 1.6;
        }

        /* ── FOOTER ────────────────────────── */
        footer {
          border-top: 1px solid var(--border);
          padding: 28px 0;
          display: flex;
          justify-content: space-between;
          align-items: center;
        }

        footer p { font-size: 13px; color: var(--text-subtle); }

        footer a {
          color: var(--text-subtle);
          text-decoration: none;
          margin-left: 22px;
          font-size: 13px;
          transition: color 0.15s;
        }

        footer a:hover { color: var(--text); }

        @media (max-width: 780px) {
          .page-body { grid-template-columns: 1fr; gap: 40px; padding: 48px 0 64px; }
          .sidebar { position: static; }
          .steps-row { grid-template-columns: 1fr 1fr; }
          .topbar { gap: 12px; }
          nav { overflow-x: auto; min-width: 0; scrollbar-width: none; }
          nav::-webkit-scrollbar { display: none; }
          nav a { padding: 6px 10px; font-size: 12.5px; }
          footer { flex-direction: column; gap: 14px; text-align: center; }
        }
    </style>
</head>
<body>

<header>
    <div class="wrapper">
        <div class="topbar">
            <a href="index.html" class="logo">mattias<span>15</span></a>
            <nav>
                <a href="mods.html">Mods</a>
                <a href="roblox.html">Roblox</a>
                <a href="commissions.html" class="active">Commissions</a>
                <a href="bisecthosting.html">Server Hosting</a>
                <a href="https://discord.gg/9XY62bv7AY" target="_blank" rel="noopener" class="nav-cta">Discord</a>
            </nav>
        </div>
    </div>
</header>

<div class="wrapper">
    <div class="page-body">

        <div class="form-panel">
            <p class="form-eyebrow">Work With Me</p>
            <h1>Commission a<br><em>project</em></h1>
            <p class="form-sub">Fill in the details below and I'll get back to you quickly via your preferred contact. I take on Minecraft mods, Roblox games/assets, websites, Discord bots, and more.</p>

            <div class="avail-pill">
                <span class="avail-dot"></span>
                Currently open for commissions
            </div>

            <div class="form-message" id="formMessage"></div>

            <form id="commissionForm" novalidate>

                <div class="form-group">
                    <label>Commission Type <span class="req">*</span></label>
                    <div class="type-pills">
                        <div class="type-pill" data-value="Minecraft Mod" onclick="selectType(this, 'mc')">Minecraft Mod</div>
                        <div class="type-pill" data-value="Roblox Project" onclick="selectType(this, 'rb')">Roblox Project</div>
                        <div class="type-pill" data-value="Custom / Other" onclick="selectType(this, 'custom')">Custom / Other</div>
                    </div>
                    <input type="hidden" id="commissionType" name="type" required>
                </div>

                <div class="form-group">
                    <label for="projectName">Project Name <span class="req">*</span></label>
                    <input type="text" id="projectName" name="projectName" placeholder="What do you want this thing called?" required>
                </div>

                <div class="form-group">
                    <label for="description">Project Description <span class="req">*</span></label>
                    <p class="form-hint">Be as detailed as possible features, mechanics, style, references.</p>
                    <textarea id="description" name="description" rows="6" placeholder="Describe what you want built..." required></textarea>
                </div>

                <div class="form-group">
                    <label for="budget">Budget (USD) <span class="req">*</span></label>
                    <input type="number" id="budget" name="budget" placeholder="Your budget can be discussed further" min="1" required>
                </div>

                <div class="form-group">
                    <label for="deadline">Deadline / Timeline</label>
                    <input type="text" id="deadline" name="deadline" placeholder="e.g. 2 weeks, end of March, flexible">
                </div>

                <div class="form-group">
                    <label for="contact">Contact Info <span class="req">*</span></label>
                    <p class="form-hint">Discord username, email, or however you want me to reach you.</p>
                    <textarea id="contact" name="contact" rows="2" placeholder="Discord: username / Email: you@example.com" required></textarea>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    Send Commission Request
                </button>

            </form>
        </div>

        <aside class="sidebar">

            <div class="sidebar-card">
                <h3>Quick Info</h3>
                <div class="sidebar-row">
                    <span class="key">Status</span>
                    <span class="val green">Open</span>
                </div>
                <div class="sidebar-row">
                    <span class="key">Response time</span>
                    <span class="val">Usually same week</span>
                </div>
                <div class="sidebar-row">
                    <span class="key">Platforms</span>
                    <span class="val">MC Java · Roblox</span>
                </div>
                <div class="sidebar-row">
                    <span class="key">Payment</span>
                    <span class="val">Negotiable</span>
                </div>
            </div>

            <div class="sidebar-card">
                <h3>What I Can Build</h3>
                <div class="sidebar-row"><span class="key">Minecraft Mods</span><span class="val green"></span></div>
                <div class="sidebar-row"><span class="key">Roblox Games</span><span class="val green"></span></div>
                <div class="sidebar-row"><span class="key">Roblox UI / Scripts</span><span class="val green"></span></div>
                <div class="sidebar-row"><span class="key">Roblox Builds</span><span class="val green"></span></div>
                <div class="sidebar-row"><span class="key">Websites</span><span class="val green"></span></div>
                <div class="sidebar-row"><span class="key">Discord Bots</span><span class="val green"></span></div>
            </div>

            <div class="sidebar-card">
                <h3>Prefer to chat first?</h3>
                <p class="sidebar-note">Feel free to DM me on Discord before filling out the form if you want to discuss your project informally.</p>
                <a href="https://discord.com/users/533087848493219851" target="_blank" rel="noopener" class="discord-link">
                    Message on Discord
                </a>
            </div>

        </aside>
    </div>

    <div class="steps-section">
        <p class="section-label">How It Works</p>
        <div class="steps-row">
            <div class="step">
                <div class="step-num">01</div>
                <h4>Submit a Request</h4>
                <p>Fill out the form above with your idea, budget, and contact info.</p>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <h4>We Discuss</h4>
                <p>I'll reach out via Discord or email to clarify details and confirm scope.</p>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <h4>I Build It</h4>
                <p>Work begins once we've agreed. I'll keep you updated throughout.</p>
            </div>
            <div class="step">
                <div class="step-num">04</div>
                <h4>Delivery</h4>
                <p>You receive the finished project files and any documentation needed.</p>
            </div>
        </div>
    </div>

    <footer>
        <p>© 2025 Mattias15. All rights reserved. (pls don't steal my website 🥹🫰)</p>
        <p>
            <a href="https://www.curseforge.com/members/mattiasay68/projects" target="_blank" rel="noopener">CurseForge</a>
            <a href="https://modrinth.com/user/mattias15" target="_blank" rel="noopener">Modrinth</a>
            <a href="https://discord.gg/9XY62bv7AY" target="_blank" rel="noopener">Discord</a>
        </p>
    </footer>
</div>

<script>
    function selectType(el, style) {
        document.querySelectorAll('.type-pill').forEach(p => p.className = 'type-pill');
        el.classList.add('sel-' + style);
        document.getElementById('commissionType').value = el.dataset.value;
    }

    document.getElementById('commissionForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const type        = document.getElementById('commissionType').value;
        const projectName = document.getElementById('projectName').value.trim();
        const description = document.getElementById('description').value.trim();
        const budget      = document.getElementById('budget').value.trim();
        const deadline    = document.getElementById('deadline').value.trim();
        const contact     = document.getElementById('contact').value.trim();
        const msg         = document.getElementById('formMessage');
        const btn         = document.getElementById('submitBtn');

        if (!type || !projectName || !description || !budget || !contact) {
            msg.className = 'form-message error';
            msg.textContent = 'Please fill in all required fields and select a commission type.';
            msg.style.display = 'block';
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Sending…';
        msg.style.display = 'none';

        const WORKER_URL = 'https://comission.mattiasayenew.workers.dev/';

        const payload = {
            type,
            projectName,
            description,
            budget: `$${budget}`,
            deadline: deadline || 'Not specified',
            contact
        };

        try {
            const res = await fetch(WORKER_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                msg.className = 'form-message success';
                msg.textContent = 'Commission request sent! I\'ll get back to you soon.';
                msg.style.display = 'block';
                document.getElementById('commissionForm').reset();
                document.querySelectorAll('.type-pill').forEach(p => p.className = 'type-pill');
            } else {
                throw new Error('Worker returned ' + res.status);
            }
        } catch (err) {
            msg.className = 'form-message error';
            msg.textContent = 'Something went wrong. Please DM me on Discord instead.';
            msg.style.display = 'block';
        }

        btn.disabled = false;
    });
</script>

