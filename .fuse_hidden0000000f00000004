<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mods | Mattias15</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
          --bg: #0a0a0b;
          --bg2: #111114;
          --bg3: #161619;
          --border: rgba(255,255,255,0.06);
          --border-hover: rgba(255,255,255,0.1);
          --text: #ededf0;
          --muted: #56565f;
          --muted2: #8a8a93;
          --mc: #4ade80;
          --mc-dim: rgba(74,222,128,0.1);
          --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
          background: var(--bg);
          color: var(--text);
          font-family: 'Inter', system-ui, -apple-system, sans-serif;
          font-size: 15px;
          font-weight: 400;
          line-height: 1.6;
          font-feature-settings: 'cv11', 'ss01', 'ss03';
          -webkit-font-smoothing: antialiased;
          text-rendering: optimizeLegibility;
          min-height: 100vh;
        }

        ::selection { background: rgba(74, 222, 128, 0.25); color: var(--text); }

        /* ── HEADER ── */
        header {
          position: sticky; top: 0; z-index: 200;
          background: rgba(10, 10, 11, 0.72);
          backdrop-filter: saturate(180%) blur(14px);
          -webkit-backdrop-filter: saturate(180%) blur(14px);
          border-bottom: 1px solid var(--border);
          height: 60px;
          display: flex; align-items: center;
        }
        .topbar {
          width: 100%; max-width: none;
          padding: 0 28px;
          display: flex; align-items: center; justify-content: space-between;
        }
        .logo {
          font-family: var(--mono);
          font-weight: 500; font-size: 14px;
          color: var(--text); text-decoration: none;
        }
        .logo span { color: var(--mc); }

        nav { display: flex; gap: 8px; align-items: center; }
        nav a {
          font-size: 13.5px; font-weight: 500;
          color: var(--muted2); text-decoration: none;
          padding: 7px 14px;
          border-radius: 8px;
          border: 1px solid var(--border);
          background: var(--bg2);
          white-space: nowrap;
          transition: color 0.15s, background 0.15s, border-color 0.15s;
        }
        nav a:hover {
          color: var(--text);
          background: var(--bg3);
          border-color: var(--border-hover);
        }
        nav a.active {
          color: var(--mc);
          background: var(--mc-dim);
          border-color: rgba(74, 222, 128, 0.3);
        }
        .nav-discord {
          margin-left: 4px;
          color: #052010 !important;
          background: var(--mc) !important;
          border: 1px solid transparent !important;
          font-weight: 600;
        }
        .nav-discord:hover { background: #6ee89a !important; }

        /* ── LAYOUT ── */
        .page-layout { display: flex; min-height: calc(100vh - 56px); }

        .sidebar {
          width: 220px; flex-shrink: 0;
          position: sticky; top: 56px;
          height: calc(100vh - 56px);
          overflow-y: auto;
          border-right: 1px solid var(--border);
          padding: 1.25rem 0;
          scrollbar-width: thin;
          scrollbar-color: var(--border) transparent;
        }
        .sidebar::-webkit-scrollbar { width: 3px; }
        .sidebar::-webkit-scrollbar-thumb { background: var(--border); }

        .sidebar-label {
          font-family: var(--mono);
          font-size: 0.65rem; font-weight: 500;
          letter-spacing: 0.12em; text-transform: uppercase;
          color: var(--muted); padding: 0 1rem 0.75rem;
        }
        .sidebar-item {
          display: flex; align-items: center; gap: 0.65rem;
          padding: 0.5rem 1rem;
          cursor: pointer; text-decoration: none;
          position: relative;
          transition: background 0.12s;
        }
        .sidebar-item:hover { background: rgba(255,255,255,0.03); }
        .sidebar-item.active { background: rgba(255,255,255,0.04); }
        .sidebar-item.active::before {
          content: '';
          position: absolute; left: 0; top: 0; bottom: 0; width: 2px;
          background: var(--item-accent, var(--mc));
        }
        .sidebar-dot {
          width: 6px; height: 6px; border-radius: 50%;
          flex-shrink: 0; opacity: 0.6;
        }
        .sidebar-item.active .sidebar-dot { opacity: 1; }
        .sidebar-name {
          font-size: 0.8rem; font-weight: 400;
          color: var(--muted2); flex: 1;
          transition: color 0.12s;
          white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .sidebar-item:hover .sidebar-name,
        .sidebar-item.active .sidebar-name { color: var(--text); }
        .sidebar-badge { font-size: 0.6rem; }

        /* ── CONTENT ── */
        .content { flex: 1; min-width: 0; }

        .mod-section {
          border-bottom: 1px solid var(--border);
          scroll-margin-top: 56px;
        }
        .mod-section:last-of-type { border-bottom: none; }
        .mod-section-content { max-width: 1040px; padding: 0 2rem; margin: 0 auto; }

        /* ── MOD HERO ── */
        .mod-hero {
          display: grid; grid-template-columns: 1fr 270px;
          gap: 0;
        }
        .hero-left {
          padding: 2.5rem 2rem 2.5rem 0;
          border-right: 1px solid var(--border);
        }
        .hero-right {
          padding: 2.5rem 0 2.5rem 2rem;
          display: flex; flex-direction: column;
        }

        .breadcrumb {
          display: flex; align-items: center; gap: 0.4rem;
          font-size: 0.75rem; color: var(--muted);
          margin-bottom: 1.25rem;
          font-family: var(--mono);
        }
        .breadcrumb a { color: var(--muted); text-decoration: none; transition: color 0.15s; }
        .breadcrumb a:hover { color: var(--muted2); }
        .breadcrumb span { opacity: 0.35; }

        .mod-status {
          display: inline-flex; align-items: center; gap: 0.4rem;
          padding: 0.2rem 0.6rem; border-radius: 3px;
          font-family: var(--mono);
          font-size: 0.67rem; font-weight: 500;
          letter-spacing: 0.06em; text-transform: uppercase;
          margin-bottom: 0.9rem;
        }
        .status-active   { background: rgba(74,222,128,0.1);  color: #4ade80; border: 1px solid rgba(74,222,128,0.2); }
        .status-paused   { background: rgba(251,191,36,0.1);  color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }
        .status-discontinued { background: rgba(232,92,92,0.1); color: #e85c5c; border: 1px solid rgba(232,92,92,0.2); }
        .status-dot { width: 5px; height: 5px; border-radius: 50%; }
        .status-active .status-dot { background: #4ade80; box-shadow: 0 0 0 3px rgba(74,222,128,0.15); }
        .status-paused .status-dot { background: #fbbf24; }
        .status-discontinued .status-dot { background: #e85c5c; }

        h1 {
          font-family: 'Inter', system-ui, sans-serif;
          font-weight: 600; font-size: clamp(1.85rem, 3.8vw, 2.75rem);
          line-height: 1.04; letter-spacing: -0.03em;
          margin-bottom: 0.75rem;
        }
        h1 em { font-style: normal; color: var(--accent, var(--mc)); }

        .hero-tagline {
          font-size: 0.95rem; color: var(--muted2);
          line-height: 1.65; max-width: 460px;
          margin-bottom: 1.5rem;
        }

        .meta-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
        .meta-tag {
          padding: 0.25rem 0.65rem;
          background: var(--bg2);
          border: 1px solid var(--border);
          border-radius: 999px;
          font-family: var(--mono);
          font-size: 0.7rem; color: var(--muted2);
        }

        .dl-btns { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .dl-btn {
          display: inline-flex; align-items: center; gap: 0.4rem;
          padding: 0.55rem 1.1rem; border-radius: 7px;
          font-size: 0.85rem; font-weight: 500;
          text-decoration: none; font-family: 'Inter', system-ui, sans-serif;
          transition: all 0.15s;
        }
        .btn-primary {
          background: var(--accent, var(--mc));
          color: #0c0c0e;
        }
        .btn-primary:hover { filter: brightness(1.08); }
        .btn-ghost {
          background: transparent; color: var(--text);
          border: 1px solid var(--border-hover);
        }
        .btn-ghost:hover { border-color: rgba(255,255,255,0.18); background: var(--bg2); }

        .mod-icon {
          width: 96px; height: 96px; border-radius: 14px;
          border: 1px solid var(--border); background: var(--bg2);
          object-fit: contain; padding: 0.5rem;
          margin-bottom: 1.25rem;
        }

        .stat-row {
          display: flex; justify-content: space-between; align-items: center;
          padding: 0.5rem 0; border-bottom: 1px solid var(--border);
          font-size: 0.8rem;
        }
        .stat-row:first-of-type { border-top: 1px solid var(--border); }
        .stat-key { color: var(--muted); }
        .stat-val {
          font-family: var(--mono);
          font-size: 0.76rem; font-weight: 500; color: var(--text);
        }

        .status-bar {
          padding: 0.75rem 1rem; border-radius: 6px;
          font-size: 0.8rem; margin-top: 1.25rem; line-height: 1.6;
        }
        .bar-paused      { background: rgba(244,185,66,0.08);  border: 1px solid rgba(244,185,66,0.18); color: #f4b942; }
        .bar-discontinued { background: rgba(232,92,92,0.08);  border: 1px solid rgba(232,92,92,0.18); color: #e85c5c; }

        /* ── WIKI BODY ── */
        .wiki-body { padding: 2rem 0 3.5rem; }

        .tab-nav {
          display: flex; border-bottom: 1px solid var(--border);
          margin-bottom: 2rem; overflow-x: auto; scrollbar-width: none;
          gap: 0;
        }
        .tab-nav::-webkit-scrollbar { display: none; }
        .tab-btn {
          padding: 0.6rem 1rem;
          font-size: 0.78rem; font-weight: 400;
          font-family: 'Inter', system-ui, sans-serif;
          color: var(--muted); background: transparent; border: none;
          border-bottom: 2px solid transparent;
          cursor: pointer; white-space: nowrap;
          transition: all 0.15s;
        }
        .tab-btn:hover { color: var(--muted2); }
        .tab-btn.active { color: var(--accent, var(--mc)); border-bottom-color: var(--accent, var(--mc)); }
        .tab-panel { display: none; animation: fadeUp 0.2s ease both; }
        .tab-panel.active { display: block; }

        .wiki-section { margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
        .wiki-section:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

        .section-h2,
        .wiki-section h2 {
          font-size: 0.72rem; font-weight: 600;
          letter-spacing: 0.08em; text-transform: uppercase;
          color: var(--muted);
          margin-bottom: 1.25rem;
          display: block;
        }

        .section-h3 {
          font-family: 'Inter', system-ui, sans-serif;
          font-size: 0.95rem; font-weight: 600;
          color: var(--text); margin: 1.85rem 0 0.7rem;
          letter-spacing: -0.015em;
        }
        .section-h3:first-of-type { margin-top: 0; }

        p { font-size: 0.87rem; color: var(--muted2); line-height: 1.75; margin-bottom: 0.65rem; }
        p strong { color: var(--text); font-weight: 500; }
        .wiki-section p { font-size: 0.87rem; color: var(--muted2); line-height: 1.75; margin-bottom: 0.65rem; }
        .wiki-section p strong { color: var(--text); font-weight: 500; }
        .wiki-section ul { padding-left: 1.1rem; }
        .wiki-section ul li { font-size: 0.85rem; color: var(--muted2); line-height: 1.7; margin-bottom: 0.35rem; }
        .wiki-section ul li strong { color: var(--text); font-weight: 500; }
        ul { padding-left: 1.1rem; margin-bottom: 0.75rem; }
        ul li { font-size: 0.85rem; color: var(--muted2); line-height: 1.7; margin-bottom: 0.3rem; }
        ul li strong { color: var(--text); font-weight: 500; }

        /* ── CAT LIST ── */
        .cat-list {
          background: var(--bg2); border: 1px solid var(--border);
          border-radius: 8px; padding: 1rem 1.25rem; margin-top: 0.75rem;
        }
        .cat-list-title {
          font-family: var(--mono);
          font-size: 0.65rem; font-weight: 500; color: var(--accent, var(--mc));
          margin-bottom: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em;
        }
        .cat-list ul { list-style: none; padding: 0; margin: 0; }
        .cat-list li {
          font-size: 0.83rem; color: var(--muted2);
          padding: 0.3rem 0; border-bottom: 1px solid var(--border);
        }
        .cat-list li:last-child { border-bottom: none; }
        .cat-list li strong { color: var(--text); }

        /* ── MOBS ── */
        .mob-entry { margin-bottom: 2.25rem; padding-bottom: 2.25rem; border-bottom: 1px solid var(--border); }
        .mob-entry:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
        .mob-images { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
        .mob-img-box {
          position: relative; overflow: hidden;
          border: 1px solid var(--border); border-radius: 8px;
          background: var(--bg2); flex: 0 0 auto; width: 280px; height: 200px;
        }
        .mob-img-box img {
          width: 100%; height: 100%; object-fit: contain;
          transition: opacity 0.4s; position: absolute; top: 0; left: 0; padding: 0.5rem;
        }
        .mob-img-box.roadrunner-box { background: #1a1f2e; }
        .mob-img-caption { font-size: 0.7rem; color: var(--muted); margin-top: 0.35rem; text-align: center; }
        .mob-img-wrap { display: flex; flex-direction: column; }
        .audio-block { margin: 0.75rem 0; }
        .audio-label {
          font-family: var(--mono);
          font-size: 0.65rem; color: var(--muted);
          font-weight: 500; margin-bottom: 0.4rem;
          text-transform: uppercase; letter-spacing: 0.08em;
        }
        audio { width: 100%; filter: invert(0.85) hue-rotate(180deg) brightness(0.8); border-radius: 4px; }
        .mob-stats {
          display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
          gap: 0.4rem; margin-top: 0.75rem;
        }
        .mob-stat { background: var(--bg2); border: 1px solid var(--border); border-radius: 6px; padding: 0.5rem 0.7rem; }
        .mob-stat-key {
          font-family: var(--mono);
          font-size: 0.62rem; color: var(--muted);
          text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.2rem;
        }
        .mob-stat-val { font-size: 0.82rem; font-weight: 500; color: var(--text); }

        /* ── BLOCK LIST ── */
        .block-list { display: flex; flex-direction: column; gap: 0.5rem; margin: 0.75rem 0; }
        .block-entry {
          display: flex; align-items: center; gap: 1rem;
          background: var(--bg2); border: 1px solid var(--border);
          border-radius: 7px; padding: 0.85rem;
          transition: border-color 0.15s;
        }
        .block-entry:hover { border-color: var(--border-hover); }
        .block-entry img {
          width: 64px; height: 64px; object-fit: contain;
          border-radius: 5px; flex-shrink: 0; background: var(--bg3); padding: 0.25rem;
        }
        .block-entry-body h4 {
          font-size: 0.85rem; font-weight: 600; margin-bottom: 0.15rem; color: var(--text);
        }
        .block-entry-body p { font-size: 0.8rem; margin: 0; color: var(--muted2); }
        .item-sm img { width: 44px; height: 44px; }

        /* ── DAGGERS ── */
        .dagger-entry {
          display: flex; gap: 1.25rem; align-items: flex-start;
          background: var(--bg2); border: 1px solid var(--border);
          border-radius: 8px; padding: 1rem; margin-bottom: 0.5rem;
          transition: border-color 0.15s; flex-wrap: wrap;
        }
        .dagger-entry:hover { border-color: var(--border-hover); }
        .dagger-entry img {
          width: 72px; height: 72px; object-fit: contain; flex-shrink: 0;
          background: var(--bg3); border-radius: 7px; padding: 0.3rem;
        }
        .dagger-entry h4 { font-size: 0.87rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text); }
        .dagger-stats { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
        .dagger-stat {
          font-family: var(--mono);
          font-size: 0.7rem; font-weight: 500; padding: 0.15rem 0.45rem;
          border-radius: 3px; background: var(--accent-dim, rgba(255,255,255,0.05));
          color: var(--accent, var(--mc)); border: 1px solid var(--accent-border, rgba(255,255,255,0.09));
        }
        .dagger-enchants { font-size: 0.75rem; color: var(--muted2); line-height: 1.6; }
        .dagger-enchants strong { color: var(--text); }

        /* ── STRUCTURES ── */
        .structure-entry { margin-bottom: 2.25rem; padding-bottom: 2.25rem; border-bottom: 1px solid var(--border); }
        .structure-entry:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
        .slideshow-wrap { display: grid; grid-template-columns: 1fr 240px; gap: 1.25rem; align-items: flex-start; }
        .slideshow {
          position: relative; overflow: hidden;
          border: 1px solid var(--border); border-radius: 8px;
          background: var(--bg2); aspect-ratio: 16/10;
        }
        .slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 1s ease; }
        .slide:not(:first-child) { opacity: 0; }
        .structure-info ul { margin-top: 0.4rem; }

        /* ── FEATURE ENTRIES ── */
        .feature-entry { display: flex; gap: 1.25rem; align-items: flex-start; margin-bottom: 1.25rem; flex-wrap: wrap; }
        .feature-entry img {
          width: 160px; height: 110px; object-fit: cover;
          border: 1px solid var(--border); border-radius: 7px; flex-shrink: 0;
        }
        .feature-entry h4 { font-size: 0.87rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--text); }
        .feature-entry p { margin: 0; }

        /* ── FEAT CARDS ── */
        .feat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
        .feat-card {
          background: var(--bg2); border: 1px solid var(--border);
          border-radius: 10px; padding: 1.1rem 1.15rem;
          transition: border-color 0.15s;
        }
        .feat-card:hover { border-color: var(--border-hover); }
        .feat-card span {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 32px; height: 32px;
          border-radius: 8px;
          background: var(--bg3);
          border: 1px solid var(--border);
          font-size: 0.95rem;
          line-height: 1;
          margin-bottom: 0.75rem;
        }
        .feat-card h4 { font-size: 0.9rem; font-weight: 600; margin-bottom: 0.3rem; color: var(--text); letter-spacing: -0.01em; }
        .feat-card p { font-size: 0.82rem; color: var(--muted2); line-height: 1.6; margin: 0; }
        .feat-card code {
          font-size: 0.78rem; background: rgba(255,255,255,0.06);
          padding: 0.12rem 0.35rem; border-radius: 4px;
          color: var(--accent, var(--mc));
          font-family: var(--mono);
        }

        /* ── STEPS ── */
        .steps { display: flex; flex-direction: column; gap: 0.4rem; }
        .step-item {
          display: flex; gap: 1rem; align-items: flex-start;
          padding: 0.85rem; background: var(--bg2);
          border: 1px solid var(--border); border-radius: 7px;
        }
        .step-num {
          font-family: var(--mono);
          font-size: 0.75rem; font-weight: 600;
          color: var(--accent, var(--mc)); opacity: 0.6;
          flex-shrink: 0; width: 24px; padding-top: 0.05rem;
        }
        .step-item h4 { font-size: 0.83rem; font-weight: 600; margin-bottom: 0.15rem; color: var(--text); }
        .step-item p { font-size: 0.78rem; color: var(--muted2); line-height: 1.6; margin: 0; }

        /* ── VARIANTS ── */
        .variants-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.5rem; margin-top: 0.75rem; }
        .variant-card {
          background: var(--bg2); border: 1px solid var(--border);
          border-radius: 7px; padding: 0.85rem; text-align: center;
          transition: border-color 0.15s;
        }
        .variant-card:hover { border-color: var(--border-hover); }
        .variant-card img {
          width: 68px; height: 68px; object-fit: contain; border-radius: 5px;
          background: var(--bg3); padding: 0.2rem; margin-bottom: 0.4rem;
          display: block; margin-left: auto; margin-right: auto;
        }
        .variant-card .vname { font-size: 0.76rem; font-weight: 500; color: var(--muted2); }

        /* ── ARMOR TABLE ── */
        .armor-table { width: 100%; border-collapse: collapse; margin-top: 0.75rem; }
        .armor-table th {
          font-family: var(--mono);
          font-size: 0.65rem; font-weight: 500; text-transform: uppercase;
          letter-spacing: 0.09em; color: var(--muted);
          padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); text-align: left;
        }
        .armor-table td { font-size: 0.82rem; color: var(--text); padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--border); }
        .armor-table tr:last-child td { border-bottom: none; }
        .armor-table tr:hover td { background: var(--bg2); }
        .tier-badge {
          display: inline-block; padding: 0.12rem 0.45rem; border-radius: 3px;
          font-family: var(--mono);
          font-size: 0.68rem; font-weight: 500;
        }
        .tier-iron   { background: rgba(180,180,190,0.1); color: #b4b4be; border: 1px solid rgba(180,180,190,0.18); }
        .tier-gold   { background: rgba(212,160,23,0.1);  color: #d4a017; border: 1px solid rgba(212,160,23,0.18); }
        .tier-diamond { background: rgba(79,200,220,0.1); color: #4fc8dc; border: 1px solid rgba(79,200,220,0.18); }

        /* ── TAG CLOUD ── */
        .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.35rem; }
        .tag {
