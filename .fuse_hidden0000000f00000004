<script>
    const MOD_ORDER = [
      'capybaras',
      'scorching-desert',
      'miners-dream',
      'random-items',
      'cobble-blocks',
      'pedestals',
      'color-expansion',
      'mysti-grecia',
      'pixel-blocks',
    ];

    const MOD_META = {
      'scorching-desert': { name: 'Scorching Desert', status: 'Active',       accent: '#f0a030' },
      'capybaras':        { name: 'Capybaras',         status: 'Active',       accent: '#b87c4c' },
      'cobble-blocks':    { name: 'Cobble Blocks',      status: 'Dev Paused',  accent: '#e85c5c' },
      'color-expansion':  { name: 'Color Expansion',    status: 'Discontinued',accent: '#d4a017' },
      'miners-dream':     { name: 'Miners Dream',       status: 'Active',       accent: '#5bdb8a' },
      'mysti-grecia':     { name: 'Mysti Grecia',       status: 'Discontinued',accent: '#e8613c' },
      'pedestals':        { name: 'Pedestals',          status: 'Dev Paused',  accent: '#8b9ab5' },
      'pixel-blocks':     { name: 'Pixel Blocks',       status: 'Discontinued',accent: '#e85c5c' },
      'random-items':     { name: 'Random Items',       status: 'Active',       accent: '#9b72cf' },
    };

    const content = document.getElementById('content');
    const footer = content.querySelector('footer');

    MOD_ORDER.forEach(id => {
      const section = document.getElementById(id);
      if (section) content.insertBefore(section, footer);
    });

    const sidebar = document.getElementById('sidebar');
    sidebar.innerHTML = '<div class="sidebar-label">All Mods</div>';

    MOD_ORDER.forEach(id => {
      const meta = MOD_META[id];
      if (!meta) return;
      const a = document.createElement('a');
      a.className = 'sidebar-item';
      a.href = '#' + id;
      a.dataset.mod = id;
      a.style.setProperty('--item-accent', meta.accent);

      const dot = document.createElement('span');
      dot.className = 'sidebar-dot';
      dot.style.background = meta.accent;

      const name = document.createElement('span');
      name.className = 'sidebar-name';
      name.textContent = meta.name;

      const badge = document.createElement('span');
      badge.className = 'sidebar-badge';
      if (meta.status === 'Active') {
        badge.textContent = '●';
        badge.style.color = '#5bdb8a';
      } else if (meta.status === 'Dev Paused') {
        badge.textContent = '⏸';
        badge.style.color = '#f4b942';
      } else {
        badge.textContent = '✕';
        badge.style.color = '#e85c5c';
      }

      a.append(dot, name, badge);
      sidebar.appendChild(a);

      a.addEventListener('click', e => {
        e.preventDefault();
        const target = document.getElementById(id);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const section = btn.closest('.mod-section');
        if (!section) return;
        section.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        section.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const panelId = section.id + '-tab-' + btn.dataset.tab;
        const panel = document.getElementById(panelId);
        if (panel) panel.classList.add('active');
      });
    });

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          document.querySelectorAll('.sidebar-item').forEach(item => item.classList.remove('active'));
          const active = document.querySelector(`.sidebar-item[data-mod="${entry.target.id}"]`);
          if (active) {
            active.classList.add('active');
            active.scrollIntoView({ block: 'nearest' });
          }
        }
      });
    }, { threshold: 0.15, rootMargin: '-56px 0px -55% 0px' });

    document.querySelectorAll('.mod-section').forEach(s => observer.observe(s));

    const coyoteImgs = ['../img/scorchingdesert/mobs/coyote_run_1.png','../img/scorchingdesert/mobs/coyote_run_2.png','../img/scorchingdesert/mobs/coyote_run_3.png'];
    let ci = 0;
    const coyoteEl = document.getElementById('coyote-img');
    if (coyoteEl) {
      setInterval(() => {
        ci = (ci + 1) % coyoteImgs.length;
        coyoteEl.style.opacity = 0;
        setTimeout(() => { coyoteEl.src = coyoteImgs[ci]; coyoteEl.style.opacity = 1; }, 300);
      }, 5000);
    }

    const huskImgs = ['../img/scorchingdesert/mobs/coyote_husk_1.png','../img/scorchingdesert/mobs/coyote_husk_2.png','../img/scorchingdesert/mobs/coyote_husk_3.png'];
    let hi = 0;
    const huskEl = document.getElementById('coyote-husk-img');
    if (huskEl) {
      setInterval(() => {
        hi = (hi + 1) % huskImgs.length;
        huskEl.style.opacity = 0;
        setTimeout(() => { huskEl.src = huskImgs[hi]; huskEl.style.opacity = 1; }, 300);
      }, 5000);
    }

    function makeSlideshow(id) {
      const slides = document.querySelectorAll('#' + id + ' .slide');
      if (!slides.length) return;
      let cur = 0;
      setInterval(() => {
        slides[cur].style.opacity = 0;
        cur = (cur + 1) % slides.length;
        slides[cur].style.opacity = 1;
      }, 3000);
    }
    makeSlideshow('ss-temple');
    makeSlideshow('ss-red-temple');
</script>

