<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Server Hosting · Mattias15</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
          --bg: #0a0a0b;
          --surface: #111114;
          --surface-2: #161619;
          --border: rgba(255, 255, 255, 0.06);
          --border-strong: rgba(255, 255, 255, 0.1);
          --text: #ededf0;
          --text-muted: #8a8a93;
          --text-subtle: #56565f;
          --green: #4ade80;
          --bh: #f97316;
          --bh-soft: rgba(249, 115, 22, 0.1);
          --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
        }

        html { scroll-behavior: smooth; }

        body {
          background: var(--bg);
          color: var(--text);
          font-family: 'Inter', system-ui, -apple-system, sans-serif;
          font-size: 15px;
          line-height: 1.6;
          font-feature-settings: 'cv11', 'ss01', 'ss03';
          -webkit-font-smoothing: antialiased;
        }

        ::selection { background: rgba(249, 115, 22, 0.25); color: var(--text); }

        .wrapper {
          max-width: 1080px;
          margin: 0 auto;
          padding: 0 28px;
        }

        /* ── HEADER ────────────────────────── */
        header {
          position: sticky; top: 0; z-index: 50;
          border-bottom: 1px solid var(--border);
          background: rgba(10, 10, 11, 0.72);
          backdrop-filter: saturate(180%) blur(14px);
          -webkit-backdrop-filter: saturate(180%) blur(14px);
        }

        .topbar {
          display: flex; align-items: center; justify-content: space-between;
          height: 60px;
        }

        .logo {
          font-family: var(--mono);
          font-size: 14px; font-weight: 500;
          color: var(--text); text-decoration: none;
        }
        .logo span { color: var(--green); }

        nav { display: flex; align-items: center; gap: 8px; }

        nav a {
          font-size: 13.5px; font-weight: 500;
          color: var(--text-muted); text-decoration: none;
          padding: 7px 14px; border-radius: 8px;
          border: 1px solid var(--border);
          background: var(--surface);
          white-space: nowrap;
          transition: color 0.15s, background 0.15s, border-color 0.15s;
        }
        nav a:hover {
          color: var(--text);
          background: var(--surface-2);
          border-color: var(--border-strong);
        }
        nav a.active {
          color: var(--green);
          background: rgba(74, 222, 128, 0.1);
          border-color: rgba(74, 222, 128, 0.3);
        }

        .nav-cta {
          color: #052010 !important;
          background: var(--green);
          border-color: transparent;
          margin-left: 4px;
          font-weight: 600;
        }
        .nav-cta:hover {
          background: #6ee89a;
          border-color: transparent;
        }

        /* ── HERO ──────────────────────────── */
        .hero {
          display: grid;
          grid-template-columns: 1fr 340px;
          gap: 48px;
          padding: 72px 0 64px;
          align-items: center;
        }

        .hero-eyebrow {
          font-size: 12px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--bh);
          margin-bottom: 22px;
        }

        h1 {
          font-size: clamp(32px, 4.8vw, 48px);
          font-weight: 600;
          line-height: 1.04;
          letter-spacing: -0.03em;
          margin-bottom: 16px;
        }

        h1 em { font-style: normal; color: var(--bh); }

        .hero-sub {
          font-size: 16px;
          color: var(--text-muted);
          line-height: 1.65;
          max-width: 460px;
          margin-bottom: 26px;
        }

        .promo-pill {
          display: inline-flex;
          align-items: center;
          gap: 10px;
          padding: 8px 14px;
          border-radius: 999px;
          background: var(--bh-soft);
          border: 1px solid rgba(249, 115, 22, 0.2);
          color: var(--text);
          font-size: 13.5px;
          margin-bottom: 24px;
        }

        .promo-code {
          font-family: var(--mono);
          font-size: 12.5px;
          font-weight: 500;
          color: var(--bh);
          background: rgba(249, 115, 22, 0.15);
          padding: 3px 8px;
          border-radius: 5px;
        }

        .btn-bh {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          padding: 12px 22px;
          background: var(--bh);
          color: #fff;
          border-radius: 8px;
          font-size: 14px;
          font-weight: 500;
          text-decoration: none;
          transition: background 0.15s, transform 0.1s;
          align-self: flex-start;
        }

        .btn-bh:hover { background: #fb923c; }
        .btn-bh:active { transform: translateY(1px); }

        .hero-aside {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 14px;
          padding: 24px;
        }

        .bh-logo-wrap {
          padding-bottom: 18px;
          margin-bottom: 6px;
          border-bottom: 1px solid var(--border);
        }

        .bh-logo-wrap img {
          width: 100%;
          max-width: 220px;
          height: auto;
          display: block;
        }

        .stat-stack { display: flex; flex-direction: column; }

        .stat-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 11px 0;
          border-bottom: 1px solid var(--border);
          font-size: 13.5px;
        }
        .stat-row:last-child { border-bottom: none; padding-bottom: 0; }

        .stat-key { color: var(--text-muted); }
        .stat-val { font-weight: 500; color: var(--text); }
        .stat-val.accent { color: var(--bh); font-family: var(--mono); font-size: 12.5px; }

        /* ── SECTIONS ──────────────────────── */
        .section {
          padding: 56px 0;
          border-top: 1px solid var(--border);
        }

        .section-label {
          font-size: 11.5px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--text-subtle);
          margin-bottom: 28px;
          display: block;
        }

        .ram-grid {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 14px;
        }

        .ram-card {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 12px;
          padding: 24px 22px;
          transition: border-color 0.15s;
        }

        .ram-card:hover { border-color: var(--border-strong); }

        .ram-players {
          font-size: 30px;
          font-weight: 600;
          letter-spacing: -0.035em;
          color: var(--text);
          line-height: 1.1;
          margin-bottom: 4px;
        }

        .ram-label {
          font-size: 12.5px;
          color: var(--text-muted);
          margin-bottom: 16px;
        }

        .ram-amount {
          font-family: var(--mono);
          font-size: 14px;
          font-weight: 500;
          color: var(--bh);
          margin-bottom: 6px;
        }

        .ram-note {
          font-size: 12.5px;
          color: var(--text-subtle);
          line-height: 1.55;
        }

        /* ── FEATURES ──────────────────────── */
        .features-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 14px;
        }

        .feature-card {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 12px;
          padding: 24px;
          transition: border-color 0.15s;
        }

        .feature-card:hover { border-color: var(--border-strong); }

        .feature-icon {
          width: 34px;
          height: 34px;
          border-radius: 8px;
          background: var(--surface-2);
          border: 1px solid var(--border);
          display: inline-flex;
          align-items: center;
          justify-content: center;
          color: var(--bh);
          margin-bottom: 16px;
        }



        .feature-card h4 {
          font-size: 14.5px;
          font-weight: 600;
          margin-bottom: 6px;
          color: var(--text);
          letter-spacing: -0.01em;
        }

        .feature-card p {
          font-size: 13.5px;
          color: var(--text-muted);
          line-height: 1.65;
        }

        /* ── CTA ───────────────────────────── */
        .cta-bar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          border: 1px solid var(--border);
          border-radius: 14px;
          padding: 32px 36px;
          background:
            radial-gradient(ellipse at right, rgba(249, 115, 22, 0.06), transparent 60%),
            var(--surface);
          margin: 32px 0 56px;
          gap: 28px;
          flex-wrap: wrap;
        }

        .cta-bar h2 {
          font-size: 22px;
          font-weight: 600;
          letter-spacing: -0.025em;
          margin-bottom: 6px;
        }

        .cta-bar p {
          font-size: 14px;
          color: var(--text-muted);
          line-height: 1.55;
        }

        .cta-right {
          display: flex;
          flex-direction: column;
          align-items: flex-end;
          gap: 10px;
          flex-shrink: 0;
        }

        .cta-url {
          font-family: var(--mono);
          font-size: 12px;
          color: var(--text-subtle);
          text-decoration: none;
          transition: color 0.15s;
        }

        .cta-url:hover { color: var(--text-muted); }

        /* ── FOOTER ────────────────────────── */
        footer {
          border-top: 1px solid var(--border);
          padding: 28px 0;
          display: flex; justify-content: space-between; align-items: center;
        }

        footer p { font-size: 13px; color: var(--text-subtle); }

        footer a {
          color: var(--text-subtle); text-decoration: none;
          margin-left: 22px; font-size: 13px;
          transition: color 0.15s;
        }
        footer a:hover { color: var(--text); }

        @media (max-width: 920px) {
          .ram-grid { grid-template-columns: 1fr 1fr; }
          .features-grid { grid-template-columns: 1fr 1fr; }
          .hero { grid-template-columns: 1fr; gap: 32px; padding: 48px 0; }
        }

        @media (max-width: 620px) {
          .ram-grid { grid-template-columns: 1fr; }
          .features-grid { grid-template-columns: 1fr; }
          .cta-bar { flex-direction: column; align-items: flex-start; padding: 28px; }
          .cta-right { align-items: flex-start; width: 100%; }
          .topbar { gap: 12px; }
          nav { overflow-x: auto; min-width: 0; scrollbar-width: none; }
          nav::-webkit-scrollbar { display: none; }
          nav a { padding: 6px 10px; font-size: 12.5px; }
          footer { flex-direction: column; gap: 14px; text-align: center; }
        }
    </style>
</head>
