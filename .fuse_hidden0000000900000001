    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
          --bg: #0a0a0b;
          --surface: #111114;
          --surface-2: #161619;
          --border: rgba(255, 255, 255, 0.06);
          --border-strong: rgba(255, 255, 255, 0.1);
          --text: #ededf0;
          --text-muted: #8a8a93;
          --text-subtle: #56565f;
          --green: #4ade80;
          --green-soft: rgba(74, 222, 128, 0.1);
          --orange: #f97316;
          --orange-soft: rgba(249, 115, 22, 0.1);
          --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
        }

        html { scroll-behavior: smooth; }

        body {
          background: var(--bg);
          color: var(--text);
          font-family: 'Inter', system-ui, -apple-system, sans-serif;
          font-size: 15px;
          line-height: 1.6;
          font-feature-settings: 'cv11', 'ss01', 'ss03';
          -webkit-font-smoothing: antialiased;
          text-rendering: optimizeLegibility;
        }

        ::selection { background: rgba(74, 222, 128, 0.25); color: var(--text); }

        .wrapper {
          max-width: 1080px;
          margin: 0 auto;
          padding: 0 28px;
        }

        /* ── HEADER ────────────────────────── */
        header {
          position: sticky;
          top: 0;
          z-index: 50;
          border-bottom: 1px solid var(--border);
          background: rgba(10, 10, 11, 0.72);
          backdrop-filter: saturate(180%) blur(14px);
          -webkit-backdrop-filter: saturate(180%) blur(14px);
        }

        .topbar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          height: 60px;
        }

        .logo {
          font-family: var(--mono);
          font-size: 14px;
          font-weight: 500;
          color: var(--text);
          text-decoration: none;
          letter-spacing: -0.01em;
        }

        .logo span { color: var(--green); }

        nav {
          display: flex;
          align-items: center;
          gap: 8px;
        }

        nav a {
          font-size: 13.5px;
          font-weight: 500;
          color: var(--text-muted);
          text-decoration: none;
          padding: 7px 14px;
          border-radius: 8px;
          border: 1px solid var(--border);
          background: var(--surface);
          white-space: nowrap;
          transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
        }

        nav a:hover {
          color: var(--text);
          background: var(--surface-2);
          border-color: var(--border-strong);
        }

        nav a.active {
          color: var(--green);
          background: rgba(74, 222, 128, 0.1);
          border-color: rgba(74, 222, 128, 0.3);
        }

        .nav-cta {
          color: #052010 !important;
          background: var(--green);
          border-color: transparent;
          margin-left: 4px;
          font-weight: 600;
        }

        .nav-cta:hover {
          background: #6ee89a;
          border-color: transparent;
        }

        /* ── HERO ──────────────────────────── */
        .hero {
          padding: 96px 0 80px;
          display: grid;
          grid-template-columns: 1fr auto;
          align-items: center;
          gap: 56px;
        }

        .hero-eyebrow {
          font-size: 12px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--text-subtle);
          margin-bottom: 24px;
        }

        h1 {
          font-size: clamp(34px, 5.4vw, 58px);
          font-weight: 600;
          line-height: 1.04;
          letter-spacing: -0.035em;
          color: var(--text);
          margin-bottom: 22px;
        }

        h1 em {
          font-style: normal;
          color: var(--green);
          font-weight: 600;
        }

        .hero-sub {
          font-size: 16.5px;
          color: var(--text-muted);
          max-width: 460px;
          line-height: 1.65;
          margin-bottom: 36px;
        }

        .hero-actions {
          display: flex;
          gap: 10px;
          flex-wrap: wrap;
        }

        .btn {
          display: inline-flex;
          align-items: center;
          gap: 7px;
          padding: 10px 18px;
          border-radius: 8px;
          font-size: 14px;
          font-weight: 500;
          font-family: inherit;
          text-decoration: none;
          cursor: pointer;
          border: 1px solid transparent;
          transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
          white-space: nowrap;
          line-height: 1;
        }

        .btn:active { transform: translateY(1px); }

        .btn-primary {
          background: var(--green);
          color: #052010;
        }

        .btn-primary:hover { background: #6ee89a; }

        .btn-orange {
          background: var(--orange);
          color: #fff;
        }

        .btn-orange:hover { background: #fb923c; }

        .btn-ghost {
          background: transparent;
          color: var(--text);
          border-color: var(--border-strong);
        }

        .btn-ghost:hover {
          background: var(--surface);
          border-color: rgba(255, 255, 255, 0.18);
        }

        .hero-avatar {
          width: 132px;
          height: 132px;
          border-radius: 18px;
          overflow: hidden;
          background: var(--surface);
          flex-shrink: 0;
          position: relative;
        }

        .hero-avatar::after {
          content: '';
          position: absolute;
          inset: 0;
          border-radius: inherit;
          box-shadow: inset 0 0 0 1px var(--border-strong);
          pointer-events: none;
        }

        .hero-avatar img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }

        /* ── STATS ─────────────────────────── */
        .stats-row {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          padding: 28px 0 36px;
          border-top: 1px solid var(--border);
        }

        .stat-item {
          padding-right: 20px;
        }

        .stat-num {
          font-size: 30px;
          font-weight: 600;
          letter-spacing: -0.035em;
          color: var(--text);
          line-height: 1.1;
          margin-bottom: 6px;
        }

        .stat-label {
          font-size: 12.5px;
          color: var(--text-muted);
          font-weight: 400;
        }

        /* ── SECTION HEADER ────────────────── */
        .section-header {
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          padding: 56px 0 22px;
        }

        .section-label {
          font-size: 11.5px;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--text-subtle);
        }

        .section-link {
          font-size: 13px;
          color: var(--text-muted);
          text-decoration: none;
          transition: color 0.15s;
        }

        .section-link:hover { color: var(--text); }

        /* ── PLATFORM CARDS ────────────────── */
        .platforms {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 14px;
          margin-bottom: 16px;
        }

        .platform-card {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 14px;
          padding: 28px;
          transition: border-color 0.15s ease, transform 0.15s ease;
        }

        .platform-card:hover {
          border-color: var(--border-strong);
        }

        .platform-badge {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 4px 10px;
          border-radius: 999px;
          font-size: 11.5px;
          font-weight: 500;
          margin-bottom: 22px;
          letter-spacing: -0.005em;
        }

        .platform-badge::before {
          content: '';
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: currentColor;
        }

        .badge-green { background: var(--green-soft); color: var(--green); }
        .badge-orange { background: var(--orange-soft); color: var(--orange); }

        .platform-card h2 {
          font-size: 21px;
          font-weight: 600;
          letter-spacing: -0.022em;
          margin-bottom: 10px;
          color: var(--text);
        }

        .platform-card p {
          font-size: 14.5px;
          color: var(--text-muted);
          line-height: 1.65;
          margin-bottom: 26px;
        }

        .platform-links {
          display: flex;
          gap: 8px;
          flex-wrap: wrap;
        }

        .pill {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 7px 13px;
          border-radius: 7px;
          font-size: 13px;
          font-weight: 500;
          text-decoration: none;
          border: 1px solid var(--border);
          color: var(--text-muted);
          background: transparent;
          transition: color 0.15s, border-color 0.15s, background 0.15s;
        }

        .pill:hover {
          border-color: var(--border-strong);
          color: var(--text);
          background: var(--surface-2);
        }

        /* ── FEATURED PROJECT ──────────────── */
        .featured {
          margin-bottom: 16px;
        }

        .featured-card {
          display: grid;
          grid-template-columns: 1fr auto;
          align-items: center;
          gap: 32px;
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 14px;
          padding: 32px;
          text-decoration: none;
          color: inherit;
          transition: border-color 0.15s;
        }

        .featured-card:hover {
          border-color: var(--border-strong);
        }

        .project-badges {
          display: flex;
          align-items: center;
          gap: 8px;
          margin-bottom: 12px;
        }

        .tag {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          padding: 3px 9px;
          border-radius: 999px;
          font-size: 11.5px;
          font-weight: 500;
        }

        .tag::before {
          content: '';
          width: 5px;
          height: 5px;
          border-radius: 50%;
          background: currentColor;
        }

        .tag-green { background: var(--green-soft); color: var(--green); }
        .tag-orange { background: var(--orange-soft); color: var(--orange); }

        .featured-card h3 {
          font-size: 24px;
          font-weight: 600;
          letter-spacing: -0.025em;
          color: var(--text);
          margin-bottom: 8px;
        }

        .featured-card > div > p {
          font-size: 14.5px;
          color: var(--text-muted);
          line-height: 1.65;
          margin-bottom: 18px;
          max-width: 540px;
        }

        .project-links {
          display: flex;
          gap: 8px;
          flex-wrap: wrap;
        }

        .featured-mark {
          width: 84px;
          height: 84px;
          border-radius: 14px;
          background: var(--surface-2);
          border: 1px solid var(--border);
          display: flex;
          align-items: center;
          justify-content: center;
          color: var(--text-subtle);
        }

        /* ── SERVICES ──────────────────────── */
        .services-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 14px;
          margin-bottom: 16px;
        }

        .service-card {
          background: var(--surface);
          border: 1px solid var(--border);
          border-radius: 14px;
          padding: 26px;
          transition: border-color 0.15s;
        }

        .service-card:hover { border-color: var(--border-strong); }

        .service-icon {
          width: 36px;
          height: 36px;
          border-radius: 9px;
          background: var(--surface-2);
          border: 1px solid var(--border);
          display: inline-flex;
          align-items: center;
          justify-content: center;
          color: var(--text);
          margin-bottom: 18px;
        }

        .service-icon svg { width: 17px; height: 17px; stroke-width: 1.6; }

        .service-card h4 {
          font-size: 15.5px;
          font-weight: 600;
          letter-spacing: -0.015em;
          margin-bottom: 6px;
          color: var(--text);
        }

        .service-card p {
          font-size: 13.5px;
          color: var(--text-muted);
          line-height: 1.65;
        }

        /* ── CTA ───────────────────────────── */
        .cta-section {
          border: 1px solid var(--border);
          border-radius: 16px;
          padding: 56px 40px;
          text-align: center;
          background:
            radial-gradient(ellipse at top, rgba(74, 222, 128, 0.06), transparent 60%),
            var(--surface);
          margin: 32px 0 56px;
        }

        .cta-section h2 {
          font-size: 30px;
          font-weight: 600;
          letter-spacing: -0.03em;
          margin-bottom: 12px;
          color: var(--text);
        }

        .cta-section > p {
          color: var(--text-muted);
          font-size: 15.5px;
          margin: 0 auto 32px;
          max-width: 440px;
          line-height: 1.6;
        }

        .cta-links {
          display: flex;
          gap: 10px;
          justify-content: center;
          flex-wrap: wrap;
        }

        /* ── FOOTER ────────────────────────── */
        footer {
          border-top: 1px solid var(--border);
          padding: 28px 0;
          display: flex;
          justify-content: space-between;
          align-items: center;
        }

        footer p { font-size: 13px; color: var(--text-subtle); }

        footer a {
          color: var(--text-subtle);
          text-decoration: none;
          margin-left: 22px;
          font-size: 13px;
          transition: color 0.15s;
        }

        footer a:hover { color: var(--text); }

        /* ── RESPONSIVE ────────────────────── */
        @media (max-width: 720px) {
          .hero { padding: 56px 0 48px; grid-template-columns: 1fr; gap: 36px; }
          .hero-avatar { width: 88px; height: 88px; order: -1; }
          .stats-row { grid-template-columns: 1fr 1fr; gap: 24px 16px; }
          .platforms { grid-template-columns: 1fr; }
          .featured-card { grid-template-columns: 1fr; }
          .featured-mark { display: none; }
          .services-grid { grid-template-columns: 1fr; }
          .cta-section { padding: 40px 24px; }
          .topbar { gap: 12px; }
          nav { overflow-x: auto; min-width: 0; scrollbar-width: none; }
          nav::-webkit-scrollbar { display: none; }
          nav a { padding: 6px 10px; font-size: 12.5px; }
          footer { flex-direction: column; gap: 14px; text-align: center; }
        }
    </style>
</head>
